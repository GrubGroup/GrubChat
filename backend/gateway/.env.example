# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Auth (Better Auth) ---
# Secret used to sign/encrypt sessions. Use a long random value (>= 32 chars).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of THIS gateway — OAuth callbacks resolve against it.
BETTER_AUTH_URL=http://localhost:4000
# Google OAuth credentials (server-side code-exchange flow — both required).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Internal service-to-service auth ---
# Shared secret for the gateway -> ai_service hop (sent as X-Internal-Secret).
# MUST be identical to JWT_SECRET in ai_service, or every internal call 401s.
JWT_SECRET=change-me-and-match-ai_service

# --- Cookies ---
# Set to 'true' ONLY when the frontend and gateway are on different domains (e.g.
# a Render frontend against a Fly gateway). It switches the Better Auth session
# cookie to SameSite=None; Secure so it can ride cross-site. Leave unset for local
# dev, where the Vite proxy makes the cookie first-party.
CROSS_SITE_COOKIES=false

# --- Downstream services ---
AI_SERVICE_URL=http://localhost:8000

# --- External APIs ---
# Geocodio API key — turns a member's address into lat/lon at write time.
# Optional: if unset, addresses save with null coordinates (no hard failure).
GEOCODIO_API=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grubgroup

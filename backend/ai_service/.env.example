# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grubgroup

# --- LLM chat provider switch ---
# Selects which chat client app/ai/llm/client.py builds — no code edit needed.
#   salesforce → Salesforce internal model gateway (Claude), for local dev
#   openrouter → OpenRouter/DeepSeek (default), for deploy
# Leave unset on deploy (defaults to openrouter); set to salesforce locally.
LLM_PROVIDER=openrouter

# --- LLM chat (Salesforce internal model gateway, OpenAI-compatible) ---
# Used when LLM_PROVIDER=salesforce. BASE_URL + LLM_MODEL have config defaults;
# set at least the API key. TLS verifies against NODE_EXTRA_CA_CERTS when set.
SALESFORCE_API_KEY=
SALESFORCE_LLM_MODEL=
SALESFORCE_BASE_URL=
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca-bundle.pem

# --- Embeddings (ALWAYS OpenRouter / Qwen) + OpenRouter chat ---
# OPENROUTER_* also serve chat when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# OpenRouter chat model (feeds settings.active_llm_model when LLM_PROVIDER=openrouter).
LLM_MODEL=deepseek/deepseek-v4-flash

# --- Extraction routing (the conversational analyze turn) ---
# Implements backend/CLAUDE.md's rule "cheap model for extraction, strong model
# for ranking/justification". The analyze turn is EXTRACTION, so it routes here
# instead of to LLM_PROVIDER/LLM_MODEL (which still serve the group re-rank).
#
# This is a measured latency fix, not a preference. The turn is output-token-bound
# (~13 ms/token): on the strong ranking model it ran ~3.9 s p50, versus a ~700 ms
# real-time voice budget. Routing extraction to gemini-2.5-flash + letting the
# server author the reply brought it to ~951 ms p50 with identical extraction
# quality (scripts/measure_analyze_latency.py, scripts/verify_stage0b.py).
#
# Pin the PROVIDER and MODEL together — the same model measured ~3x slower through
# the Salesforce gateway, so the win comes from the pair. Blank EXTRACTION_PROVIDER
# falls back to LLM_PROVIDER/LLM_MODEL.
EXTRACTION_PROVIDER=openrouter
EXTRACTION_MODEL=google/gemini-2.5-flash
# Master switch for the fast analyze path (fast model + server-authored reply).
# Set false to restore the original single-provider, model-written-reply behavior.
ANALYZE_LOW_LATENCY=true

# --- Geocoding (Geocodio) ---
# Turns a member's named location into lat/lon on the conversational analyze
# path. Optional: if unset, locations save with null coordinates (no failure).
# Accepts GEOCODIO_API_KEY or the gateway's GEOCODIO_API name.
GEOCODIO_API_KEY=

# --- Voice ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- App ---
ENV=development
LOG_LEVEL=info
